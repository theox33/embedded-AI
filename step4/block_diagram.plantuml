@startuml
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false

' Step 4: YOLOv8 pingpong + ByteTrack tracking
' High-level block diagram with GStreamer pipeline and processing steps

title Step 4 - YOLOv8 + ByteTrack (Block Diagram)

frame "GStreamer pipeline (capture + fan-out)" {
  [libcamerasrc\n(RGB16 WxH)] as cam
  [videorate\n(preview path)] as vrate_preview
  [queue\n(leaky=downstream, max=1)] as queue_preview
  [capsfilter\nRGB16 WxH @ fps] as caps_preview
  [fpsdisplaysink -> gtkwaylandsink\n(display preview)] as display

  [videorate0\n(NN path)] as vrate_nn
  [queue0\n(leaky=downstream, max=1)] as queue_nn
  [capsfilter\nRGB NN_WxNN_H @ fps] as caps_nn
  [appsink\n(sync=false, max=1, drop=true)] as appsink

  note right of cam
    Source vidéo de la caméra, fournit des images en format RGB16 et résolution WxH.
  end note

  note right of queue_preview
    Branche preview :
    - videorate ajuste le framerate pour l'affichage
    - queue (leaky) ne garde que la dernière image pour éviter la latence
    - capsfilter force le format et la fréquence d'images
    - fpsdisplaysink/gtkwaylandsink affiche le flux vidéo en temps réel
  end note

  note right of queue_nn
    Branche NN (Neural Network) :
    - videorate0 ajuste le framerate pour l'inférence
    - queue0 (leaky) ne garde que la dernière image pour garantir l'inférence en temps réel
    - capsfilter adapte la taille d'image à celle attendue par le modèle
    - appsink permet de récupérer les images dans le code Python pour traitement IA
  end note

  cam --> vrate_preview
  vrate_preview --> queue_preview
  queue_preview --> caps_preview
  caps_preview --> display

  cam --> vrate_nn
  vrate_nn --> queue_nn
  queue_nn --> caps_nn
  caps_nn --> appsink
}

package "Perception pipeline" {
  [Data acquisition\n(GStreamer appsink -> buffer)] as acquisition
  [Preprocessing\n(NumPy view, stride handling, to RGB uint8)] as preprocessing
  [Neural inference\n(TFLite runner on YOLOv8n quant)] as inference
  [Postprocessing\n(YOLOv8 decode: transpose, best cls, thresholds, NMS -> boxes/conf/classes)] as postproc

  note right of acquisition
    Récupère les images depuis appsink pour les traiter en Python.
  end note

  note right of preprocessing
    Convertit le buffer en tableau NumPy, gère le stride (décalage mémoire),
    convertit en RGB uint8, format attendu par le modèle.
  end note

  note right of inference
    Exécute le modèle YOLOv8n quantifié (TFLite) pour détecter les objets.
  end note

  note right of postproc
    Décode la sortie du modèle : transpose, sélectionne la meilleure classe,
    applique des seuils de confiance et NMS (suppression des doublons),
    produit les boîtes, scores et classes.
  end note
}

package "Tracking + semantics" {
  [Tracking\n(ByteTrack update + filtered tracks)] as tracking
  [Centroid history\n(per track, <=30 points)] as history
  [Recognition & understanding\n(label mapping 1 class: pingpong_ball)] as recognition

  note right of tracking
    Met à jour les pistes d'objets détectés, attribue des IDs stables,
    supprime les pistes peu fiables pour éviter le clignotement.
  end note

  note right of history
    Garde en mémoire les 30 derniers centroïdes de chaque piste
    pour dessiner la trajectoire de chaque objet.
  end note

  note right of recognition
    Fait le mapping du label (ici, une seule classe : pingpong_ball)
    pour l'affichage.
  end note
}

package "UI & display" {
  [Decision & overlay\n(GTK Cairo: box color by track_id, text label/#id/conf, trails)] as overlay
  [Display\n(overlay window + preview)] as display_out

  note right of overlay
    Utilise GTK Cairo pour dessiner sur l'image :
    - Boîte colorée selon le track_id (ID de suivi)
    - Texte avec label, numéro d'ID et confiance
    - Trajectoire de l'objet à partir de l'historique des centroïdes
  end note

  note right of display_out
    Affiche la fenêtre d'overlay fusionnée avec la preview vidéo.
  end note
}

appsink --> acquisition
acquisition --> preprocessing
preprocessing --> inference
inference --> postproc
postproc --> tracking
tracking --> history
tracking --> recognition
history --> overlay
recognition --> overlay
postproc --> overlay
overlay --> display_out

legend left
  # Capture: libcamerasrc fan-out -> preview & NN paths.
  # Preprocess: buffer to RGB uint8 with stride handling.
  # Inference: TFLite YOLOv8n quantized model.
  # Postprocess: decode, thresholds, NMS -> boxes/conf/classes.
  # Tracking: ByteTrack assigns stable IDs, keeps centroid history (<=30 pts).
  # Overlay: GTK Cairo draws box per track_id color, label/#id/conf, and trails.
endlegend

@enduml
